{
  "name": "md-business",
  "version": "0.0.0",
  "private": true,
  "description": "Markdown-first business document templates with specialized viewers across Docs Add-on, Chrome, VS Code, PWA, LIFF, GitHub Action.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meta-taro/md-business.git"
  },
  "homepage": "https://github.com/meta-taro/md-business",
  "bugs": {
    "url": "https://github.com/meta-taro/md-business/issues"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "scan-bundle": "node scripts/scan-bundle.mjs",
    "startup-budget": "node scripts/startup-budget.mjs",
    "oss-guard": "node scripts/oss-guard/check-tree.mjs",
    "oss-guard:strict": "node scripts/oss-guard/check-tree.mjs --strict",
    "test:oss-guard": "node --test \"scripts/oss-guard/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "oss-guard:identity": "node scripts/oss-guard/check-identity.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "husky": "^9.1.7",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/language": "^6.12.4",
      "@hono/node-server@1": "^2.0.5",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.5",
      "hono@4": "^4.12.34",
      "ip-address": "^10.3.1",
      "nanoid@3": "^3.3.17",
      "postcss@8": "^8.5.23",
      "undici@7": "^7.29.0"
    }
  }
}
