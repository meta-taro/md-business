{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Moved from the desktop app, which compiles without these two. Kept as written there.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["test/**/*", "vitest.config.ts", "dist/**"]
}
