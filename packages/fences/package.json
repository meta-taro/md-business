{
  "name": "@md-business/fences",
  "version": "0.0.0",
  "private": true,
  "description": "The chart and data fences of md-business documents, shared by the desktop app, the VS Code extension and the Chrome extension. Pure code: each app passes in how to read files and how to word problems.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
