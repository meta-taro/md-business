{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "窓の既定権限。2 つ目以降の窓（w2, w3…）も同じ権限で動く。フレームレスの自作タイトルバー用にウィンドウ操作権限を付与する。フォルダを開く導線として dialog の open のみ許可する（走査/読込は自作コマンドで root 配下の md/tsv に限定）。opener はコマンドの許可とは別に URL/パスのスコープが要り、空だと常に拒否される。Git/フォージ/PDF/MCP の command 権限は各 Phase で追加する。",
  "windows": ["main", "w*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
