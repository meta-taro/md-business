{
  "name": "@md-business/desktop",
  "version": "0.30.0",
  "private": true,
  "description": "md-business デスクトップアプリ（Tauri 2 + SvelteKit）— 7 種の業務文書を用途別ビューワーで開き、Markdown を左右 2 画面でライブ編集・PDF 出力する本命プロダクト。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "bundle:sidecar": "pnpm --filter @md-business/mcp-server bundle",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@md-business/core": "workspace:*",
    "@md-business/data-tree": "workspace:*",
    "@md-business/mcp-server": "workspace:*",
    "@md-business/renderer-pdf": "workspace:*",
    "@md-business/schema-api-spec": "workspace:*",
    "@md-business/schema-db-spec": "workspace:^",
    "@md-business/schema-investigation": "workspace:*",
    "@md-business/schema-invoice": "workspace:^",
    "@md-business/schema-nosql-db-spec": "workspace:^",
    "@md-business/schema-spec": "workspace:^",
    "@md-business/schema-test-spec": "workspace:^",
    "@md-business/schema-test-spec-tsv": "workspace:^",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.1.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.12.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
